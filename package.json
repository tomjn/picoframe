{
  "name": "picoframe",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "plugins/*", "apps/*"],
  "scripts": {
    "dev": "bun run --cwd apps/demo tauri dev",
    "build": "bun run --cwd packages/plugin-sdk build && bun run --cwd packages/frame build && bun run --cwd packages/store build && bun run --cwd plugins/hello build",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@tauri-apps/api": "^2.11.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.6.3",
    "typescript": "^6.0.3"
  }
}
