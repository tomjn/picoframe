{
  "name": "picoframe",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "plugins/*", "apps/*"],
  "scripts": {
    "dev": "bun run --cwd apps/demo tauri dev",
    "build": "bun run --cwd packages/plugin-sdk build && bun run --cwd packages/frame build && bun run --cwd packages/store build && bun run --cwd plugins/hello build && bun run --cwd plugins/worker build",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.0",
    "@tauri-apps/api": "^2.11.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.3",
    "typescript": "^6.0.3"
  }
}
